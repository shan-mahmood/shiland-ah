---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { site } from '@data/site';
import { breadcrumb } from '../../lib/schema';

const path = '/reviews/';
const title = `Reviews — Shiland Animal Hospital | Rock Hill, SC Veterinarian`;
const description = `Read what Rock Hill and Fort Mill pet families say about Shiland Animal Hospital — rated ${site.rating.value} stars across ${site.rating.count} Google reviews. See testimonials and leave your own review.`;

const schema = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Reviews', path },
  ]),
];

// Real Google reviews (kept in sync with the homepage testimonials).
const reviews = [
  {
    initial: 'C',
    name: 'Cindy H.',
    text: 'Lovely staff, punctual, knowledgeable and above all, nice. Obi-Wan was surprisingly more at ease compared to the times we took him to other vets.',
  },
  {
    initial: 'D',
    name: 'Donnie H.',
    text: 'Had an emergency with our dog. This facility was caring not only for our pet but for me and my wife. Thanks for everything y’all did for us!',
  },
  {
    initial: 'B',
    name: 'Besy J.',
    text: 'We walked in without an appointment and our fur baby still got the help she needed. We appreciate the attention, care, and how quickly we got helped.',
  },
];
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Reviews</li>
      </ol>
    </nav>
  </div>

  <section class="page-hero">
    <div class="wrap">
      <h1>What Rock Hill pet families say about Shiland</h1>
      <p class="lede">
        We’re grateful to be Rock Hill and Fort Mill’s trusted veterinary team.
        Here’s a look at our {site.rating.value}-star Google rating — and how to
        share your own experience.
      </p>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="wrap">
      <div class="rating-summary">
        <div class="rs-left">
          <div class="rs-num">{site.rating.value}</div>
          <div class="rs-meta">
            <div class="g-stars">★★★★★</div>
            <div class="rs-count">Based on <b>{site.rating.count}</b> Google reviews</div>
          </div>
        </div>
        <div class="rs-badge"><Icon name="google" size={20} />EXCELLENT</div>
      </div>

      <div class="rev-grid">
        {reviews.map((r) => (
          <div class="rev">
            <div class="stars">★★★★★</div>
            <p>"{r.text}"</p>
            <div class="who"><span class="av">{r.initial}</span><div><b>{r.name}</b><small>Google review</small></div></div>
          </div>
        ))}
      </div>

      <div class="rev-cta">
        <a class="btn btn-call btn-lg" href={site.links.googleReview} target="_blank" rel="noopener">
          <Icon name="google" size={16} class="i" />Leave a Google review
        </a>
        <a class="btn btn-ghost btn-lg" href={site.links.googleReview} target="_blank" rel="noopener">
          Read all {site.rating.count} reviews on Google
        </a>
      </div>
    </div>
  </section>

  <!-- Embedded Google Business Profile (live rating + reviews on Google) -->
  <section style="padding-top:0">
    <div class="wrap area-grid">
      <div class="area-body">
        <span class="kicker">See us on Google</span>
        <h2 style="font-size:clamp(1.6rem,3vw,2.1rem)">Verified reviews from your neighbors</h2>
        <p style="color:var(--muted);margin-top:14px">
          Every rating comes from a real Google review. Open our Google Business
          Profile to read them all, see photos, and get directions to the clinic
          at {site.address.streetShort}, {site.address.locality}.
        </p>
        <a class="btn btn-ghost" style="margin-top:20px" href={site.links.directions} target="_blank" rel="noopener" data-directions>Get directions</a>
      </div>
      <div class="map-frame">
        <iframe title="Shiland Animal Hospital on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={site.links.mapEmbed}></iframe>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
