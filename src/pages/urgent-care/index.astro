---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { site, services, booking, hoursDisplay } from '@data/site';
import { breadcrumb, service as serviceSchema, faqPage } from '../../lib/schema';

const path = '/urgent-care/';
const svc = services.find((s) => s.slug === 'pet-urgent-care-rock-hill-fort-mill')!;

const title = 'Urgent Vet Care Rock Hill & Fort Mill, SC | Walk-Ins 7 Days | Shiland Animal Hospital';
const description =
  'Same-day urgent vet care in Rock Hill & Fort Mill, SC. Walk-ins welcome 7 days a week for sudden illness and injury, with an in-house lab and X-ray for fast answers. Call (803) 752-4950.';

const nearby = ['Fort Mill', 'Tega Cay', 'Lake Wylie', 'York', 'Clover', 'Indian Land', 'Lancaster', 'Chester'];

const faqs = [
  {
    q: 'Do I need an appointment for urgent care?',
    a: `No. Walk-ins are welcome 7 days a week. If you can, call ${site.phone.display} on your way so we can have a room ready, or book a same-day slot online.`,
  },
  {
    q: 'Is Shiland open on Sunday?',
    a: 'Yes. Sunday 10 AM to 8 PM, Saturday 9 AM to 8 PM, and weekdays 8 AM to 7 PM. We see sick and injured pets every day we are open.',
  },
  {
    q: 'What is the difference between urgent care and an emergency?',
    a: 'Urgent care is for problems that need attention today but are not life-threatening: vomiting, diarrhea, limping, ear or skin infections, minor wounds, eye irritation. An emergency is trouble breathing, collapse, severe bleeding, bloat, toxin ingestion, or major trauma. We treat both during open hours, but if your pet has an emergency, call on your way in.',
  },
  {
    q: 'How much does an urgent care visit cost?',
    a: 'A sick visit starts with an exam fee, and anything beyond the exam (lab work, X-rays, medication) is itemized in an estimate you approve before we proceed. Payment plans through Cherry, CareCredit, and Scratchpay are available. Our fees are typically far lower than an overnight emergency hospital.',
  },
  {
    q: 'Do you have X-ray and lab on site?',
    a: 'Yes. Digital X-ray and an in-house lab mean bloodwork, urinalysis, and imaging are done while you wait, so most pets start treatment the same visit.',
  },
  {
    q: 'Do you see cats as well as dogs?',
    a: 'Yes. We provide urgent care for both dogs and cats, including walk-ins.',
  },
];

const schema = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Urgent Care', path },
  ]),
  serviceSchema('Urgent Vet Care', description, path),
  faqPage(faqs),
];
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/services/">Services</a></li>
        <li aria-current="page">Urgent Care</li>
      </ol>
    </nav>
  </div>

  <section class="page-hero">
    <div class="wrap">
      <h1>Urgent Vet Care in Rock Hill &amp; Fort Mill</h1>
      <p class="lede">
        Sudden illness or injury that can’t wait for a regular appointment? Shiland
        offers same-day urgent care for cats and dogs — <strong>walk-ins welcome, 7
        days a week</strong>. Call ahead if you can and our team will be ready when
        you arrive.
      </p>
      <div class="hero-actions" data-live-actions style="margin-top:8px">
        <a class="btn btn-call btn-lg" href={site.phone.href} data-cta="call">
          <Icon name="phone" size={16} class="i" />Call {site.phone.display}
        </a>
        <a class="btn btn-ghost btn-lg" href={booking.href} data-cta="book" target={booking.external ? '_blank' : undefined} rel={booking.external ? 'noopener' : undefined}>Book appointment</a>
      </div>
    </div>
  </section>

  <section style="padding-top:28px">
    <div class="wrap split">
      <div class="prose">
        <!-- Hours up top: urgent visitors need to know if we're open now. -->
        <div class="hours-block">
          <h2 style="margin-top:0">Open 7 days a week</h2>
          <ul class="hours-inline">
            {hoursDisplay.map((h) => (
              <li><span>{h.day}</span><span>{h.hours}</span></li>
            ))}
          </ul>
          <p class="side-note" id="finalStatus">Checking today’s hours…</p>
        </div>

        <h2>When to come in for urgent care</h2>
        <p>{svc.intro}</p>
        <ul>
          {svc.sections[0]?.list?.map((li) => <li>{li}</li>)}
        </ul>

        <h2>What’s included</h2>
        <ul>
          {svc.included.map((i) => <li>{i}</li>)}
        </ul>

        <h2>Walk-in and weekend vet in Rock Hill</h2>
        <p>
          Most urgent problems show up at the worst time: Sunday afternoon, after
          work, the night before a holiday. We are open evenings every weekday,
          until 8 PM on Saturday and Sunday, and we never turn away a walk-in
          during open hours. If you are searching for a vet open now or a vet
          open on Sunday near Rock Hill, come in.
        </p>

        <h2>Fast answers, close to home</h2>
        <p>
          With an in-house lab and digital X-ray, we diagnose quickly and start
          treatment the same visit — so you’re not driving to Charlotte and waiting
          hours in an ER for problems we can handle right here in Rock Hill.
        </p>

        <div class="callout">
          <h3 style="margin-top:0">Is it an emergency?</h3>
          <p>
            For serious emergencies — trauma, difficulty breathing, suspected
            poisoning, or collapse — see our <a href="/pet-emergency-care-rock-hill-fort-mill/">emergency
            care page</a> and call us on your way in. Questions about a visit?
            <a href="/contact-us/">Contact us</a>.
          </p>
        </div>

        <h2>What an urgent care visit costs</h2>
        <p>
          You will always know the price before we treat. A sick visit starts with
          the exam; lab work, X-rays, and medication are itemized in an estimate you
          approve first. <a href="/payment-plans/">Payment plans</a> are available,
          and our fees are typically far lower than an overnight emergency hospital.
        </p>

        <h2>Urgent vet care near Fort Mill, Tega Cay, Lake Wylie, and Indian Land</h2>
        <p>
          We are on Celanese Road in Rock Hill, a short drive from {nearby.join(', ')}.
          For families in York, Lancaster, and Chester County, we are usually the
          closest same-day option that is actually open when you need it.
        </p>

        <h2>Urgent care questions</h2>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <aside>
        <div class="side-card">
          <h3>Come in or call ahead</h3>
          <p>Walk-ins are always welcome. A quick call lets our team prepare before you arrive.</p>
          <div data-live-actions>
            <a class="btn btn-call" href={site.phone.href} data-cta="call">
              <Icon name="phone" size={16} class="i" />Call {site.phone.display}
            </a>
            <a class="btn btn-ghost" href={booking.href} data-cta="book" target={booking.external ? '_blank' : undefined} rel={booking.external ? 'noopener' : undefined}>Book appointment</a>
          </div>
          <p style="margin-top:16px;font-size:.9rem"><a href="/pet-emergency-care-rock-hill-fort-mill/">Emergency care →</a></p>
          <p style="font-size:.9rem"><a href="/contact-us/">Contact &amp; directions →</a></p>
        </div>
      </aside>
    </div>
  </section>

  <FinalCTA showStatus={false} />
</BaseLayout>

<style>
  .hours-block {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px 24px;
    background: #f6f8f7;
    margin-bottom: 28px;
  }
  .hours-inline {
    list-style: none;
    padding: 0;
    margin: 8px 0 4px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 4px 20px;
  }
  .hours-inline li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dotted var(--line);
    padding: 4px 0;
  }
  .hours-inline li span:first-child { font-weight: 600; }
  .callout {
    border: 1px solid var(--line);
    border-left: 4px solid var(--honey, #f36621);
    border-radius: 12px;
    padding: 16px 20px;
    background: #fff;
    margin-top: 24px;
  }
  .faq details { border-bottom: 1px solid var(--line); padding: 12px 0; }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--pine-deep);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--pine); font-weight: 700; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { margin: 10px 0 0; }
</style>
